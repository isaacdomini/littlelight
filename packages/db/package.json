{
  "name": "@littlelight/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:migrate": "tsx src/migrate.ts up",
    "db:migrate:down": "tsx src/migrate.ts down",
    "db:seed": "tsx src/seed.ts",
    "db:types": "tsx src/gen-types.ts",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
