{
  "name": "@tinyglow/mobile-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "native:build": "VITE_API_URL=\"${VITE_API_URL:-http://localhost:8080}\" VITE_DEEPLINK_DEV_SCHEME=\"${VITE_DEEPLINK_DEV_SCHEME:-1}\" vite build",
    "native:build:release": "case \"${VITE_API_URL:-}\" in https://?*) ;; *) echo \"native:build:release: set VITE_API_URL=https://<api origin>\" >&2; exit 1 ;; esac; if [ -n \"${CAP_LIVE_RELOAD_URL:-}\" ] || [ -n \"${CAP_DEV_MIXED_CONTENT:-}\" ]; then echo \"native:build:release: unset CAP_LIVE_RELOAD_URL and CAP_DEV_MIXED_CONTENT (dev only)\" >&2; exit 1; fi; VITE_DEEPLINK_DEV_SCHEME=0 vite build",
    "native:sync": "pnpm run native:build && cap sync",
    "native:sync:ios": "pnpm run native:build && cap sync ios",
    "native:sync:android": "pnpm run native:build && cap sync android",
    "store:screenshots": "tsx scripts/store-screenshots-android.ts && ./scripts/store-screenshots-ios.sh",
    "store:screenshots:android": "tsx scripts/store-screenshots-android.ts",
    "store:screenshots:ios": "./scripts/store-screenshots-ios.sh",
    "native:assets": "tsx scripts/native-assets.ts",
    "check:ios-plists": "tsx scripts/check-ios-plists.ts",
    "ios:build:sim": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/DerivedData CODE_SIGN_IDENTITY=\"-\" CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES build",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-file-picker": "8.1.0",
    "@ionic/react": "9.0.6",
    "@ionic/react-router": "9.0.6",
    "@tinyglow/shared": "workspace:*",
    "@sentry/react": "11.6.0",
    "@tanstack/react-query": "5.104.1",
    "exifr": "7.1.3",
    "ionicons": "8.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "react-virtuoso": "4.18.16",
    "swiper": "14.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
