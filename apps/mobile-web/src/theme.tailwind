/*
 * Tailwind v4 theme tokens (docs/DESIGN.md). Kept in a non-.css file because Biome's CSS parser
 * does not read `@theme` unless tailwindDirectives is enabled in biome.json; Tailwind inlines it
 * from styles.css via @import, so utility classes (bg-surface, text-muted, rounded-xl ...) use
 * the CSS variables defined there.
 */
@theme inline {
  --font-sans: var(--font-ui);

  --color-bg: var(--bg);
  --color-surface: var(--surface);
  --color-fill: var(--fill);
  --color-fg: var(--text);
  --color-muted: var(--text-muted);
  --color-accent: var(--accent);
  --color-accent-text: var(--accent-text);
  --color-on-accent: var(--on-accent);
  --color-accent-tint: var(--accent-tint);
  --color-line: var(--border);
  --color-control: var(--control-border);
  --color-success: var(--success);
  --color-success-text: var(--success-text);
  --color-warning: var(--warning);
  --color-warning-text: var(--warning-text);
  --color-danger: var(--danger);
  --color-danger-text: var(--danger-text);

  /* type scale 28 / 22 / 17 / 15 / 13 (rem so browser/OS text size applies; never below 13) */
  --text-xs: 0.8125rem;
  --text-xs--line-height: 1.4;
  --text-sm: 0.9375rem;
  --text-sm--line-height: 1.4;
  --text-base: 1.0625rem;
  --text-base--line-height: 1.4;
  --text-lg: 1.0625rem;
  --text-lg--line-height: 1.4;
  --text-xl: 1.375rem;
  --text-xl--line-height: 1.3;
  --text-2xl: 1.75rem;
  --text-2xl--line-height: 1.2;
  --text-3xl: 1.75rem;
  --text-3xl--line-height: 1.2;

  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 12px;
  --radius-2xl: 16px;
}

