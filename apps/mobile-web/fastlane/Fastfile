# Not runnable until fastlane is installed (`bundle install`) and the accounts in
# store/release-checklist.md exist. Secrets come from the environment, never from this repo.
default_platform(:ios)

platform :ios do
  desc "Build a release IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: { signingStyle: "automatic", teamID: ENV.fetch("APPLE_TEAM_ID") },
      clean: true,
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Upload listing metadata (no binary)"
  lane :metadata do
    deliver(
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
    )
  end
end

platform :android do
  desc "Build a signed AAB and upload it to the internal testing track"
  lane :internal do
    gradle(project_dir: "android", task: "bundle", build_type: "Release")
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      metadata_path: "fastlane/metadata/android",
      skip_upload_screenshots: true,
    )
  end
end
