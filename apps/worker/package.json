{
  "name": "@littlelight/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "healthcheck": "tsx src/healthcheck.ts",
    "run-job": "tsx src/run-job.ts",
    "perf-seed": "tsx src/tools/perf-seed.ts",
    "search-seed": "tsx src/ai/search-seed.ts",
    "demo-media": "tsx src/demo/demo-media.ts",
    "google-fake": "tsx src/import/google/fake-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "search-calibrate": "tsx src/ai/search-calibrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/lib-storage": "3.1147.0",
    "@littlelight/ai": "workspace:*",
    "@littlelight/shared": "workspace:*",
    "@sentry/node": "11.6.0",
    "archiver": "8.0.0",
    "exifr": "7.1.3",
    "file-type": "22.1.1",
    "heic-decode": "2.1.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/heic-decode": "2.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
