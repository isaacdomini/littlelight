{
  "name": "@littlelight/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@fastify/cookie": "11.1.2",
    "@littlelight/ai": "workspace:*",
    "@littlelight/db": "workspace:*",
    "@littlelight/shared": "workspace:*",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
