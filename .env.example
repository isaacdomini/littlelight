# Littlelight PRODUCTION configuration template.
#
#   cp .env.example .env && chmod 600 .env    # on the server only; .env is git-ignored
#
# Every value below is a placeholder. Never commit a real value to this file.
# Generate secrets with:  openssl rand -hex 32
# (hex, not base64: base64's "/" and "+" break the postgres:// URLs below.)
#
# docker-compose.yml reads this file only for ${VAR} interpolation; no container gets the whole
# file. Each service receives just the variables its `environment:` block lists (e.g. api and
# worker never see POSTGRES_PASSWORD, SMTP or tunnel credentials). Adding a variable here is not
# enough for the apps to see it: also add it to docker-compose.yml (x-app-env or the service).
# Development does NOT use this file: see .env.dev (+ optional .env.local).
#
# Not used anywhere (self-hosted GoTrue, no Supabase gateway):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# --- Runtime ----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
TZ=UTC
# Public origin of the web app; /api and /auth are served from it.
PUBLIC_URL=https://littlelight.tesarsoft.com

# --- Host folders (must exist; compose refuses to start when unset) ------------------------
# Photo library (MinIO data), bind-mounted into `storage` at /data.
STORAGE_PATH=/srv/littlelight/storage
# Nightly pg_dump archives (docker/backup/pg-backup.sh). chmod 700.
BACKUP_PATH=/srv/littlelight/backups
BACKUP_RETENTION_DAYS=35
# Local hour (TZ) of the nightly dump.
BACKUP_HOUR=3

# --- Postgres -----------------------------------------------------------------------------
# Each service connects as its own role; docker-compose.yml builds every DATABASE_URL from the
# passwords below, so there is no DATABASE_URL to set here:
#   db-init, migrate  postgres://postgres:${POSTGRES_PASSWORD}@db:5432/littlelight   (superuser)
#   auth (GoTrue)     postgres://supabase_auth_admin:${AUTH_DB_PASSWORD}@db:5432/littlelight
#   api               postgres://littlelight_api:${API_DB_PASSWORD}@db:5432/littlelight
#   worker            postgres://littlelight_worker:${WORKER_DB_PASSWORD}@db:5432/littlelight
# db-init (re)applies the three role passwords on every start, so rotating one is: edit .env,
# then `docker compose up -d --force-recreate db-init auth api worker`.
# Every password: hex only (openssl rand -hex 32); role passwords must be >= 16 characters (the
# bootstrap refuses shorter when NODE_ENV=production).
# Never set log_statement=all, log_parameter_max_length_on_error > 0 or pg_stat_statements
# parameter capture on the db: per-request claims and DATA_ENCRYPTION_KEY are bind parameters.
#
# Superuser password for the db container (db-init, migrate and the backup job only).
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
# supabase_auth_admin (GoTrue's DB user).
AUTH_DB_PASSWORD=change-me-openssl-rand-hex-32
# littlelight_api (api; no BYPASSRLS, switches to authenticated/viewer/service_role per request).
API_DB_PASSWORD=change-me-openssl-rand-hex-32
# littlelight_worker (worker + pg-boss; switches to pipeline per job).
WORKER_DB_PASSWORD=change-me-openssl-rand-hex-32

# --- Encryption at rest (pgcrypto: photo GPS + baby home coordinates) ------------------------
# At least 32 characters (openssl rand -hex 32). Given to api and worker only.
# Store a copy OUTSIDE the server and outside the backups (password manager): the nightly
# dumps contain only ciphertext, and without this key GPS/home locations are unrecoverable.
# Changing it makes existing ciphertext unreadable (re-encryption is a separate procedure).
DATA_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# --- JWT ----------------------------------------------------------------------------------
# Signs GoTrue access tokens; the api/worker verify with it. At least 32 characters.
# docker-compose.yml passes it to GoTrue as GOTRUE_JWT_SECRET.
JWT_SECRET=change-me-openssl-rand-hex-32

# --- Email (Postmark or Resend over SMTP; used by GoTrue for OTP codes) ----------------------
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
# From address; must be a verified sender with the provider.
SMTP_ADMIN_EMAIL=noreply@littlelight.tesarsoft.com
# Provider API token for app emails (invites) sent by the api (later steps), one of:
# POSTMARK_TOKEN=
# RESEND_API_KEY=
# Redirect URLs GoTrue accepts (comma list). Step 3 adds the app's deep-link scheme.
GOTRUE_URI_ALLOW_LIST=https://littlelight.tesarsoft.com/**

# --- Social sign-in (step 3; leave disabled until real client IDs exist) -------------------
GOTRUE_EXTERNAL_APPLE_ENABLED=false
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Object storage (MinIO) ----------------------------------------------------------------
# MinIO root credentials (storage) and the S3 keys api/worker use.
S3_ACCESS_KEY=change-me-openssl-rand-hex-16
S3_SECRET_KEY=change-me-openssl-rand-hex-32
S3_BUCKET=littlelight
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Server-side endpoint (inside the compose network).
S3_ENDPOINT=http://storage:9000
# Host in pre-signed URLs (Cloudflare Tunnel hostname routed to storage:9000).
S3_PUBLIC_ENDPOINT=https://files.littlelight.tesarsoft.com
# MinIO images (official minio/minio images are no longer published; community rebuilds).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# --- API ----------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# --- Worker -------------------------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_STALE_MS=30000

# --- AI (paid tier only; required in production) ------------------------------------------
# OPENAI_API_KEY=
# Fallback / bake-off adapter only.
# ANTHROPIC_API_KEY=
VISION_PROVIDER=openai
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024

# --- Cloudflare Tunnel --------------------------------------------------------------------
# Token from Zero Trust -> Networks -> Tunnels; hostnames per docker/cloudflared/config.example.yml.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# --- Billing (entitlement webhooks; later steps) --------------------------------------------
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Errors and traces --------------------------------------------------------------------
# SENTRY_DSN=
