# Littlelight PRODUCTION configuration template.
#
#   cp .env.example .env && chmod 600 .env    # on the server only; .env is git-ignored
#
# Every value below is a placeholder. Never commit a real value to this file.
# Generate secrets with:  openssl rand -hex 32
# (hex, not base64: base64's "/" and "+" break the postgres:// URLs below.)
#
# docker-compose.yml reads this file twice: for ${VAR} interpolation in the compose file (db,
# auth, storage, backup, cloudflared get only what they need) and as env_file for migrate, api
# and worker. Development does NOT use this file: see .env.dev (+ optional .env.local).
#
# Not used anywhere (self-hosted GoTrue, no Supabase gateway):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# --- Runtime ----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
TZ=UTC
# Public origin of the web app; /api and /auth are served from it.
PUBLIC_URL=https://littlelight.tesarsoft.com

# --- Host folders (must exist; compose refuses to start when unset) ------------------------
# Photo library (MinIO data), bind-mounted into `storage` at /data.
STORAGE_PATH=/srv/littlelight/storage
# Nightly pg_dump archives (docker/backup/pg-backup.sh). chmod 700.
BACKUP_PATH=/srv/littlelight/backups
BACKUP_RETENTION_DAYS=35
# Local hour (TZ) of the nightly dump.
BACKUP_HOUR=3

# --- Postgres -----------------------------------------------------------------------------
# Superuser password for the db container (and the backup job).
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
# Used by migrate, api and worker. Same password as POSTGRES_PASSWORD.
# (Step 2 moves api/worker to a non-superuser app role.)
DATABASE_URL=postgres://postgres:change-me-openssl-rand-hex-32@db:5432/littlelight
# Password the migrate job sets on the supabase_auth_admin role (GoTrue's DB user).
# Must be at least 16 characters when NODE_ENV=production (the bootstrap refuses shorter).
AUTH_DB_PASSWORD=change-me-openssl-rand-hex-32

# --- JWT ----------------------------------------------------------------------------------
# Signs GoTrue access tokens; the api/worker verify with it. At least 32 characters.
# docker-compose.yml passes it to GoTrue as GOTRUE_JWT_SECRET.
JWT_SECRET=change-me-openssl-rand-hex-32

# --- Email (Postmark or Resend over SMTP; used by GoTrue for OTP codes) ----------------------
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
# From address; must be a verified sender with the provider.
SMTP_ADMIN_EMAIL=noreply@littlelight.tesarsoft.com
# Provider API token for app emails (invites) sent by the api, one of:
# POSTMARK_TOKEN=
# RESEND_API_KEY=
# Redirect URLs GoTrue accepts (comma list). Step 3 adds the app's deep-link scheme.
GOTRUE_URI_ALLOW_LIST=https://littlelight.tesarsoft.com/**

# --- Social sign-in (step 3; leave disabled until real client IDs exist) -------------------
GOTRUE_EXTERNAL_APPLE_ENABLED=false
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Object storage (MinIO) ----------------------------------------------------------------
# MinIO root credentials (storage) and the S3 keys api/worker use.
S3_ACCESS_KEY=change-me-openssl-rand-hex-16
S3_SECRET_KEY=change-me-openssl-rand-hex-32
S3_BUCKET=littlelight
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Server-side endpoint (inside the compose network).
S3_ENDPOINT=http://storage:9000
# Host in pre-signed URLs (Cloudflare Tunnel hostname routed to storage:9000).
S3_PUBLIC_ENDPOINT=https://files.littlelight.tesarsoft.com
# MinIO images (official minio/minio images are no longer published; community rebuilds).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# --- API ----------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# --- Worker -------------------------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_STALE_MS=30000

# --- AI (paid tier only; required in production) ------------------------------------------
# OPENAI_API_KEY=
# Fallback / bake-off adapter only.
# ANTHROPIC_API_KEY=
VISION_PROVIDER=openai
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024

# --- Cloudflare Tunnel --------------------------------------------------------------------
# Token from Zero Trust -> Networks -> Tunnels; hostnames per docker/cloudflared/config.example.yml.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# --- Billing (entitlement webhooks; later steps) --------------------------------------------
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Errors and traces --------------------------------------------------------------------
# SENTRY_DSN=
