# Littlelight PRODUCTION configuration template.
#
#   cp .env.example .env && chmod 600 .env    # on the server only; .env is git-ignored
#
# Every value below is a placeholder. Never commit a real value to this file.
# Generate secrets with:  openssl rand -hex 32
# (hex, not base64: base64's "/" and "+" break the postgres:// URLs below.)
#
# docker-compose.yml reads this file only for ${VAR} interpolation; no container gets the whole
# file. Each service receives just the variables its `environment:` block lists (e.g. api and
# worker never see POSTGRES_PASSWORD or tunnel credentials; SMTP goes to auth and api only, never
# the worker). Adding a variable here is not enough for the apps to see it: also add it to
# docker-compose.yml (x-app-env or the service).
# Development does NOT use this file: see .env.dev (+ optional .env.local).
#
# Not used anywhere (self-hosted GoTrue, no Supabase gateway):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# --- Runtime ----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
TZ=UTC
# Public origin of the web app; /api and /auth are served from it. Also the JWT issuer base
# (GoTrue signs iss=${PUBLIC_URL}/auth, the api verifies exactly that), the link base in emails
# (invites, magic links) and the OAuth redirect base (${PUBLIC_URL}/auth/callback).
PUBLIC_URL=https://littlelight.tesarsoft.com

# --- Host folders (must exist; compose refuses to start when unset) ------------------------
# Photo library (MinIO data), bind-mounted into `storage` at /data.
STORAGE_PATH=/srv/littlelight/storage
# Nightly pg_dump archives (docker/backup/pg-backup.sh). chmod 700.
BACKUP_PATH=/srv/littlelight/backups
BACKUP_RETENTION_DAYS=35
# Local hour (TZ) of the nightly dump.
BACKUP_HOUR=3

# --- Postgres -----------------------------------------------------------------------------
# Each service connects as its own role; docker-compose.yml builds every DATABASE_URL from the
# passwords below, so there is no DATABASE_URL to set here:
#   db-init, migrate  postgres://postgres:${POSTGRES_PASSWORD}@db:5432/littlelight   (superuser)
#   auth (GoTrue)     postgres://supabase_auth_admin:${AUTH_DB_PASSWORD}@db:5432/littlelight
#   api               postgres://littlelight_api:${API_DB_PASSWORD}@db:5432/littlelight
#   worker            postgres://littlelight_worker:${WORKER_DB_PASSWORD}@db:5432/littlelight
# db-init (re)applies the three role passwords on every start, so rotating one is: edit .env,
# then `docker compose up -d --force-recreate db-init auth api worker`.
# Every password: hex only (openssl rand -hex 32); role passwords must be >= 16 characters (the
# bootstrap refuses shorter when NODE_ENV=production).
# Never set log_statement=all, log_parameter_max_length_on_error > 0 or pg_stat_statements
# parameter capture on the db: per-request claims and DATA_ENCRYPTION_KEY are bind parameters.
#
# Superuser password for the db container (db-init, migrate and the backup job only).
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
# supabase_auth_admin (GoTrue's DB user).
AUTH_DB_PASSWORD=change-me-openssl-rand-hex-32
# littlelight_api (api; no BYPASSRLS, switches to authenticated/viewer/service_role per request).
API_DB_PASSWORD=change-me-openssl-rand-hex-32
# littlelight_worker (worker + pg-boss; switches to pipeline per job).
WORKER_DB_PASSWORD=change-me-openssl-rand-hex-32

# --- Encryption at rest (pgcrypto: photo GPS + baby home coordinates) ------------------------
# At least 32 characters (openssl rand -hex 32). Given to api and worker only.
# Store a copy OUTSIDE the server and outside the backups (password manager): the nightly
# dumps contain only ciphertext, and without this key GPS/home locations are unrecoverable.
# Changing it makes existing ciphertext unreadable (re-encryption is a separate procedure).
DATA_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# --- JWT ----------------------------------------------------------------------------------
# Signs GoTrue access tokens; the api/worker verify with it. At least 32 characters.
# docker-compose.yml passes it to GoTrue as GOTRUE_JWT_SECRET.
JWT_SECRET=change-me-openssl-rand-hex-32

# --- Email (Postmark or Resend over SMTP) -----------------------------------------------------
# One SMTP account for everything: GoTrue sends sign-in codes, the api sends invites and
# new-device alerts. Use a provider with SPF, DKIM and DMARC set up for the sending domain.
#   Postmark: SMTP_HOST=smtp.postmarkapp.com, SMTP_PORT=587, user = pass = Server API token
#   Resend:   SMTP_HOST=smtp.resend.com,      SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=re_...
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
# true only for implicit TLS (port 465); 587 upgrades with STARTTLS when false.
SMTP_SECURE=false
# From address for every email (GoTrue and api); a verified sender with the provider. Set
# either; MAIL_FROM wins, SMTP_ADMIN_EMAIL is the step-1 name kept as its fallback.
SMTP_ADMIN_EMAIL=noreply@littlelight.tesarsoft.com
MAIL_FROM=noreply@littlelight.tesarsoft.com
# Not used: app emails go over the SMTP account above (docs/plans/step-3.md D9).
#   POSTMARK_TOKEN, RESEND_API_KEY
# Redirect URLs GoTrue accepts for OAuth redirect_to (comma list); covers /signin/callback.
GOTRUE_URI_ALLOW_LIST=https://littlelight.tesarsoft.com/**

# --- Bot protection (Cloudflare Turnstile) ---------------------------------------------------
# Widget for littlelight.tesarsoft.com (Cloudflare dashboard -> Turnstile). After 3 code requests
# from one IP in an hour the sign-in form must pass a Turnstile challenge. Leave both empty to
# disable (the captcha threshold is then inert). The site key is public (served by the api's
# /api/auth/config); the secret is given to the api only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Social sign-in (leave disabled until real credentials exist) ---------------------------
# Each *_ENABLED flag turns the provider on in GoTrue AND shows its button in the app (the api
# reads the same flag). Redirect / return URL to register at BOTH providers:
#   https://littlelight.tesarsoft.com/auth/callback
#
# Sign in with Apple (Apple Developer account): an App ID with the Sign in with Apple capability
# (bundle id), a Services ID for the web with the return URL above, and a Sign in with Apple key
# (.p8) with its Key ID and your Team ID.
GOTRUE_EXTERNAL_APPLE_ENABLED=false
# Comma list, web first: <Services ID for web>,<iOS bundle ID for native sign-in>
APPLE_CLIENT_ID=
# Client-secret JWT (ES256) generated from the .p8 key, Key ID, Team ID and Services ID. Apple
# caps its lifetime at 6 months: regenerate before it expires or Apple web sign-in stops working.
APPLE_CLIENT_SECRET=
#
# Google (Google Cloud Console): OAuth consent screen + a Web client with the redirect URI above;
# iOS and Android clients are added for native sign-in (step 9).
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
# Comma list, web first: <web client ID>,<iOS client ID>,<Android client ID>
GOOGLE_CLIENT_ID=
# Secret of the Web client.
GOOGLE_CLIENT_SECRET=

# --- Object storage (MinIO) ----------------------------------------------------------------
# Three key pairs (docs/plans/step-4.md 2.11). MinIO limits: access key 3-20 characters, secret
# 8-40; all six values hex (openssl rand -hex 8 for access keys, -hex 20 for secrets) and all
# different.
#
# MinIO ROOT credentials: given to `storage` and `storage-init` only, never to api or worker.
# (Before step 4 this pair was called S3_ACCESS_KEY / S3_SECRET_KEY; on an existing install copy
# the old values here unchanged: MinIO's root identity must not change under existing data.)
S3_ROOT_USER=change-me-openssl-rand-hex-8
S3_ROOT_PASSWORD=change-me-openssl-rand-hex-20
# Bucket-scoped MinIO users, created/converged by storage-init (docker/minio/init.sh) with the
# policies in docker/minio/. Each app gets only its own pair (as S3_ACCESS_KEY/S3_SECRET_KEY):
#   api:    get/put objects, abort + list multipart parts. No delete, no versions, no admin.
S3_API_ACCESS_KEY=change-me-openssl-rand-hex-8
S3_API_SECRET_KEY=change-me-openssl-rand-hex-20
#   worker: the api's rights + delete objects and object versions (trash purge, dedupe).
S3_WORKER_ACCESS_KEY=change-me-openssl-rand-hex-8
S3_WORKER_SECRET_KEY=change-me-openssl-rand-hex-20
# Rotating a service-account SECRET: edit it here, then
#   docker compose up -d --force-recreate storage-init api worker
# (storage-init resets the user's secret; api/worker restart with the new one). Rotating an
# ACCESS KEY creates a new user; afterwards remove the old one (it keeps its policy):
#   docker compose run --rm --entrypoint sh storage-init -c \
#     'mc alias set local http://storage:9000 "$S3_ROOT_USER" "$S3_ROOT_PASSWORD" >/dev/null && mc admin user remove local <old-access-key>'
# Rotating the ROOT pair needs MinIO's root-credential rotation procedure (not just an edit).
S3_BUCKET=littlelight
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Server-side endpoint (inside the compose network).
S3_ENDPOINT=http://storage:9000
# Host in pre-signed URLs (Cloudflare Tunnel hostname routed to storage:9000; the tunnel
# forwards only /${S3_BUCKET}/... paths, see docker/cloudflared/config.example.yml).
S3_PUBLIC_ENDPOINT=https://files.littlelight.tesarsoft.com
# Origins allowed to PUT parts / GET signed URLs from a browser (MinIO CORS). Default: PUBLIC_URL.
# Comma list; step 9 may add the Capacitor origins (capacitor://localhost,https://localhost).
# S3_CORS_ALLOW_ORIGIN=
# MinIO images (official minio/minio images are no longer published; community rebuilds).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# --- API ----------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# --- Worker -------------------------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_STALE_MS=30000
# photo.ingest jobs per worker process (1-8). The worker container is capped at 2 GB
# (mem_limit); raise both together. Scale out with `docker compose up -d --scale worker=3`.
INGEST_CONCURRENCY=2
# The worker warns once when the STORAGE_PATH filesystem passes this % used (50-99).
STORAGE_DISK_ALERT_PCT=80
# CSAM hash matching (docs/plans/step-4.md 2.9). `none` (default) logs a warning at startup.
# `photodna` sends each 768 px analysis JPEG to Microsoft PhotoDNA Cloud Service: needs your
# enrolment, the provider's terms/DPA and an NCMEC reporting procedure first.
CSAM_MATCHER=none
# PHOTODNA_API_KEY=
# PHOTODNA_ENDPOINT=

# --- AI (paid tier only; required in production) ------------------------------------------
# docs/plans/step-6.md 2.10, docs/plans/step-7.md 2.11. Photos, notes and chat of free-tier
# babies are never sent to a model. OPENAI_API_KEY goes to the worker (vision batches, search
# document embeddings) and the api (chat with function calling, query embeddings); never to
# web or migrate. Without it both log "AI disabled: ..." and paid babies get no descriptions,
# search runs keyword + filters only, and chat answers "Chat is not configured on this server".
# Use an API-tier key (no training on customer data). Requests use store:false; the worker
# deletes provider batch files as soon as results are stored.
# OPENAI_API_KEY=
# Fallback / bake-off vision adapter only (VISION_PROVIDER=anthropic; worker only). Optional.
# There is no Anthropic chat adapter yet (step-7 D10): chat needs VISION_PROVIDER=openai.
# ANTHROPIC_API_KEY=
# openai | anthropic. The single provider switch for vision, embeddings and chat (api + worker).
# Never `fake` here: api and worker refuse the fake providers in production unless
# AI_ALLOW_FAKE_IN_PRODUCTION=true, which docker-compose.yml deliberately does not pass.
VISION_PROVIDER=openai
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
# Batch pipeline (api + worker). A batch is submitted every AI_BATCH_FLUSH_MINUTES or as soon
# as it holds AI_BATCH_MAX_PHOTOS photos, whichever comes first.
AI_BATCH_FLUSH_MINUTES=30
AI_BATCH_MAX_PHOTOS=1000
# Hard monthly spend cap per baby in USD (photos over it wait for next month), and the % of it
# at which the worker logs a warning.
AI_BABY_MONTHLY_BUDGET_USD=3
AI_BUDGET_ALERT_PCT=80
# Warn when the oldest photo waiting for AI is older than this (PRD: alert at 2 h).
AI_QUEUE_AGE_ALERT_MINUTES=120
# Failed attempts per photo (invalid output, refusal, expiry) before it is marked failed and
# needs an admin "Retry".
AI_MAX_ATTEMPTS=2
# Worker-only tuning; leave unset for the defaults shown. AI_BATCH_MAX_BYTES caps one provider
# upload (a bigger batch is split); AI_IMAGE_DETAIL is auto | low | high.
# AI_BATCH_MAX_BYTES=150000000
# AI_FLUSH_INTERVAL_CRON=*/5 * * * *
# AI_POLL_INTERVAL_CRON=*/5 * * * *
# AI_MAX_OUTPUT_TOKENS=1200
# AI_IMAGE_DETAIL=auto
# Leave EMPTY in production (empty = api.openai.com / api.anthropic.com). Only for pointing the
# adapters at a local mock server in testing; whatever is set here receives photos, search
# documents and chat messages. OPENAI_BASE_URL reaches api + worker, ANTHROPIC_BASE_URL the
# worker only.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# --- Search (docs/plans/step-7.md; api + worker; paid tier only) ----------------------------
# Hybrid search = SQL filters + vector (EMBED_MODEL at EMBED_DIMS) + full-text, fused with RRF.
# Values shown are the code defaults; leave them unless the bench says otherwise.
# Optional LLM re-rank of the top 30 fused results: off | llm. `llm` adds one chat-model call
# (~1 s, ~$0.0003) per search and is off until the bake-off shows it helps.
SEARCH_RERANK=off
# Filtered candidate sets up to this many photos use an exact vector scan (precise when filters
# are selective); larger sets use the HNSW index with iterative scans. 100-20000.
SEARCH_EXACT_MAX=2000
# hnsw.ef_search for the HNSW path: higher = better recall, slower. 40-1000.
SEARCH_HNSW_EF_SEARCH=100
# Worker cron (5 fields, TZ) that re-embeds stale or missing search rows.
SEARCH_RECONCILE_CRON=17 * * * *
# Search documents per embeddings request in the worker (1-512).
SEARCH_EMBED_BATCH=100

# --- Chat (docs/plans/step-7.md; api; parents of paid babies only) ---------------------------
# Rolling 24 h turn limit per user (PRD cost control); further turns get 429 until one ages out.
# Chat spend also counts against AI_BABY_MONTHLY_BUDGET_USD.
CHAT_TURNS_PER_DAY=100
# Model calls (tool rounds) per turn before the agent asks for a more specific question (1-8).
CHAT_MAX_TOOL_ROUNDS=4
# Output-token cap per model call (128-4096).
CHAT_MAX_OUTPUT_TOKENS=800
# Earlier thread messages sent as context with each turn (0-100).
CHAT_HISTORY_MESSAGES=20
# Timeout per model call in ms; a turn is bounded by this x CHAT_MAX_TOOL_ROUNDS. Chat streams
# over SSE through Cloudflare Tunnel and nginx (unbuffered on the chat path, 180 s read timeout;
# the api sends keepalive comments so Cloudflare's 100 s idle limit is never reached).
CHAT_MODEL_TIMEOUT_MS=30000

# --- Sharing (docs/plans/step-8.md; share links for family, no account) ----------------------
# Nothing secret to add: viewer-session JWTs and passcode/IP hashes use keys derived from
# JWT_SECRET (rotating JWT_SECRET also signs every share-link viewer out). Link expiry (24 h
# default, 30 days max), passcode attempt limits (5 per IP per 15 min, 20 per link per hour)
# and the 20-links-per-baby cap are fixed in code, not configurable here.
# Lifetime in seconds (30-900) of the presigned thumb/display/download URLs given to viewers
# (api). Revoking a link stops every API call at once; URLs already handed out keep working at
# most this long. They are sent with Cache-Control: private, so no shared cache keeps them.
SHARE_MEDIA_URL_TTL_SEC=300
# Worker cron (5 fields, TZ) that re-applies auto-share rules (Plus only, AI-analysed and
# non-sensitive photos only) to catch anything a missed job left out.
SHARE_RECONCILE_CRON=41 * * * *

# --- Cloudflare Tunnel (cloudflared runs outside Docker Compose) ----------------------------
# The stack publishes exactly two ports for the tunnel; nothing else (no MinIO console, db,
# auth, api, mail). Public hostnames to configure on the tunnel (ingress reference with the
# exact rules: docker/cloudflared/config.example.yml):
#   littlelight.tesarsoft.com        -> http://localhost:${WEB_PORT}       (nginx)
#   files.littlelight.tesarsoft.com  -> http://localhost:${STORAGE_PORT}   (MinIO S3 API)
#     - leave "HTTP Host Header" EMPTY (keep the original Host): presigned URL signatures are
#       validated against files.littlelight.tesarsoft.com
#     - path ^/<S3_BUCKET>/. only (e.g. ^/littlelight/.), so MinIO's admin/metrics/health and
#       bucket-listing paths are not public
#     - REQUIRED: a Cloudflare Cache Rule "Bypass cache" for hostname
#       files.littlelight.tesarsoft.com (Caching -> Cache Rules), so photos are never cached at
#       the edge and revoked share links leave nothing to purge. Presigned GETs already carry
#       Cache-Control: private; steps in docker/cloudflared/config.example.yml.
# Default binds are loopback (cloudflared on this host). If cloudflared runs on another machine,
# set *_BIND to this server's LAN address and firewall both ports to that machine only: anything
# that reaches them bypasses Cloudflare and can forge CF-Connecting-IP (used for rate limits).
WEB_BIND=127.0.0.1
WEB_PORT=8080
STORAGE_BIND=127.0.0.1
STORAGE_PORT=9000

# --- Billing (entitlement webhooks; later steps) --------------------------------------------
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Errors and traces --------------------------------------------------------------------
# SENTRY_DSN=
