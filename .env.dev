# Littlelight DEVELOPMENT defaults. Committed on purpose: every value here is a throwaway,
# local-only default for docker-compose.dev.yml. NEVER put a real secret in this file.
# Personal secrets (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...) and overrides go in .env.local
# (git-ignored, optional, loaded after this file). Production config lives in .env on the
# server; see .env.example.
#
# Loaded via env_file by: migrate, api, worker, web (auth/storage/storage-init get explicit
# environment blocks in docker-compose.dev.yml instead).
# Not used: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (self-hosted GoTrue).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Postgres (db service: user postgres / password dev) -------------------
DATABASE_URL=postgres://postgres:dev@db:5432/littlelight

# --- Shared with auth/storage: defined ONCE in docker-compose.dev.yml (x-dev-shared) -------
# JWT_SECRET (= GoTrue's GOTRUE_JWT_SECRET), S3_ACCESS_KEY / S3_SECRET_KEY (= MinIO root),
# S3_BUCKET, AUTH_DB_PASSWORD (supabase_auth_admin) are injected via `environment:` into both
# sides, so they always match; they are not read from this file or .env.local.
# GoTrue's own settings (GOTRUE_*, API_EXTERNAL_URL) live on the `auth` service there too.

# --- Object storage (MinIO; keys and bucket come from docker-compose.dev.yml) -------
S3_ENDPOINT=http://storage:9000
# Host used in pre-signed URLs the browser/phone calls. For a phone on the LAN, set the
# laptop's LAN IP in .env.local, e.g. S3_PUBLIC_ENDPOINT=http://192.168.1.20:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# --- Worker ----------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_STALE_MS=30000

# --- AI (paid tier only; skipped with a log line unless OPENAI_API_KEY is set in .env.local) ---
VISION_PROVIDER=openai
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
# OPENAI_API_KEY=      -> .env.local only
# ANTHROPIC_API_KEY=   -> .env.local only

# --- Web (Vite dev server only) ----------------------------------------------
VITE_PROXY_API_TARGET=http://api:3000
VITE_PROXY_AUTH_TARGET=http://auth:9999
# Extra hostnames Vite accepts (comma list); add your LAN hostname in .env.local for phones.
VITE_ALLOWED_HOSTS=web
# VITE_USE_POLLING=1   -> set in .env.local if hot reload misses edits on your machine
