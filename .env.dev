# Littlelight DEVELOPMENT defaults. Committed on purpose: every value here is a throwaway,
# local-only default for docker-compose.dev.yml. NEVER put a real secret in this file.
# Personal secrets (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...) and overrides go in .env.local
# (git-ignored, optional, loaded after this file). Production config lives in .env on the
# server; see .env.example.
#
# Loaded via env_file by: migrate, api, worker, web (db-init/auth/storage/storage-init get
# explicit environment blocks in docker-compose.dev.yml instead).
# Not used: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (self-hosted GoTrue).

# --- Host ports (Compose interpolation, NOT read from this file) ---------------
# Published host ports default to WEB_PORT=8080, STORAGE_PORT=9000, STORAGE_CONSOLE_PORT=9001,
# DB_PORT=5432, AUTH_PORT=9999, API_PORT=3000, MAILPIT_PORT=8025. If one is taken, export the
# variable in your shell or put it in a git-ignored `.env` next to docker-compose.dev.yml (Compose
# reads that file for ${VAR} interpolation; .env.dev / .env.local cannot change ports). PUBLIC_URL,
# the GoTrue issuer/redirects and S3_PUBLIC_ENDPOINT follow WEB_PORT / STORAGE_PORT automatically.
# (API_PORT below is the api's in-container listen port and stays 3000.)

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Postgres (db service: user postgres / password dev) -------------------
# DATABASE_URL is NOT set here: it differs per service and is set in docker-compose.dev.yml
# (x-dev-shared):
#   db-init, migrate  postgres://postgres:dev@db:5432/littlelight             (superuser)
#   api               postgres://littlelight_api:dev@db:5432/littlelight      (app role, RLS)
#   worker            postgres://littlelight_worker:dev@db:5432/littlelight   (app role, RLS)
# From the host (tests, psql) use localhost:5432 with the same users/passwords.

# Demo family seed (docs/plans/step-2.md 2.9), run by `migrate` on every dev start, and its
# images (docs/plans/step-9.md 2.11), rendered into MinIO by the `worker` on start. Both
# idempotent. Set SEED_DEMO_FAMILY=false in .env.local to skip both. Never set in production.
SEED_DEMO_FAMILY=true

# --- Shared between services: defined ONCE in docker-compose.dev.yml (x-dev-shared) -------
# JWT_SECRET (= GoTrue's GOTRUE_JWT_SECRET), S3_ACCESS_KEY / S3_SECRET_KEY (api: MinIO user
# littlelight-api; worker: littlelight-worker; both created by storage-init; neither is the MinIO
# root dev / devdevdev, which only storage and storage-init get), S3_BUCKET, the role passwords AUTH_DB_PASSWORD (supabase_auth_admin), API_DB_PASSWORD
# (littlelight_api), WORKER_DB_PASSWORD (littlelight_worker), and DATA_ENCRYPTION_KEY (pgcrypto
# key for GPS / home coordinates; migrate, api, worker) are injected via `environment:` into
# every side that needs them, so they always match; they are not read from this file or
# .env.local. GoTrue's own settings (GOTRUE_*, API_EXTERNAL_URL) live on the `auth` service.

# --- Object storage (MinIO; keys and bucket come from docker-compose.dev.yml) -------
S3_ENDPOINT=http://storage:9000
# S3_PUBLIC_ENDPOINT (host in pre-signed URLs the browser/phone calls) is set on api/worker in
# docker-compose.dev.yml: http://localhost:${STORAGE_PORT:-9000}. For a phone on the LAN, set
# S3_PUBLIC_ENDPOINT=http://<laptop-lan-ip>:9000 in the shell or the git-ignored project `.env`
# (not .env.local: it is a Compose interpolation value).
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# --- Auth (docs/plans/step-3.md 2.8) -----------------------------------------------
# The API is GoTrue's only client for codes/verify/refresh/sign-out (internal network).
AUTH_INTERNAL_URL=http://auth:9999
# Set on the api service in docker-compose.dev.yml (x-dev-shared), not here, because they must
# match GoTrue / Mailpit: PUBLIC_URL=http://localhost:${WEB_PORT:-8080} (JWT issuer = PUBLIC_URL/auth),
# AUTH_APPLE_ENABLED / AUTH_GOOGLE_ENABLED (= GoTrue's GOTRUE_EXTERNAL_*_ENABLED, default false;
# see the compose header to try Google locally), SMTP_HOST=mail, SMTP_PORT=1025,
# SMTP_SECURE=false, MAIL_FROM=noreply@littlelight.local. The worker gets no SMTP settings.
# Turnstile is off in dev (no keys => the captcha threshold is inert). To exercise it, put
# Cloudflare's public TEST keys in .env.local (these two always pass; not secrets):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Worker ----------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_STALE_MS=30000
# Set on the worker in docker-compose.dev.yml: INGEST_CONCURRENCY (default 2; export it in the
# shell before `up` to change), STORAGE_DISK_PATH=/storage (dev-s3, read-only) and mem_limit 2g.
# Optional in .env.local: STORAGE_DISK_ALERT_PCT (default 80).
# CSAM hash matching is off in dev (no provider; the worker logs one line at startup).
CSAM_MATCHER=none

# --- AI (paid tier only; skipped with a log line unless OPENAI_API_KEY is set in .env.local) ---
# docs/plans/step-6.md 2.10, docs/plans/step-7.md 2.11. Free-tier photos are never sent to a
# model (no description, no embedding, no chat), whatever is set here.
# Keys: put them in .env.local only (git-ignored). docker-compose.dev.yml passes
# OPENAI_API_KEY to the worker (vision batches, document embeddings) and the api (chat, query
# embeddings); ANTHROPIC_API_KEY to the worker only; migrate and web get neither. Without a key
# both log "AI disabled: ..." and everything else works (search runs keyword + filters only,
# chat answers "not configured").
# OPENAI_API_KEY=      -> .env.local only
# ANTHROPIC_API_KEY=   -> .env.local only (fallback adapter / bake-off; optional)
#
# Compose INTERPOLATION variables in docker-compose.dev.yml (shell or the project `.env`, NOT
# this file or .env.local):
#   VISION_PROVIDER         api + worker: openai (default) | anthropic | fake. The single
#                           provider switch: vision batches, embeddings and chat all follow it.
#   AI_BATCH_FLUSH_MINUTES  worker: 30 (default); 0 = submit on every 5-minute flush tick
# `fake` is a deterministic in-process provider (no key, no network): fake vision batches in the
# worker, a bag-of-words fake embedder in both, a rule-based fake chat model in the api. The
# AI and search gates use it:
#   VISION_PROVIDER=fake AI_BATCH_FLUSH_MINUTES=0 docker compose -f docker-compose.dev.yml up -d --no-deps api worker
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
# Batch pipeline (aiPipelineEnvSchema in packages/shared/src/env.ts). Override in .env.local.
AI_BATCH_MAX_PHOTOS=1000
AI_BABY_MONTHLY_BUDGET_USD=3
AI_BUDGET_ALERT_PCT=80
AI_QUEUE_AGE_ALERT_MINUTES=120
AI_MAX_ATTEMPTS=2
# Optional, code defaults shown (.env.local). FAKE_VISION_POLLS = polls the fake provider
# answers `in_progress` before `completed`. *_BASE_URL empty = the real APIs (set only to point
# the adapters at a local mock server).
# AI_BATCH_MAX_BYTES=150000000
# AI_FLUSH_INTERVAL_CRON=*/5 * * * *
# AI_POLL_INTERVAL_CRON=*/5 * * * *
# AI_MAX_OUTPUT_TOKENS=1200
# AI_IMAGE_DETAIL=auto
# FAKE_VISION_POLLS=1
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# --- Search (docs/plans/step-7.md 2.4 searchEnvSchema; api + worker) -------------------------
# Optional LLM re-rank of the top 30 fused results: off | llm (one more chat call per search).
SEARCH_RERANK=off
# Filtered candidate sets up to this size use an exact vector scan; larger ones use HNSW.
SEARCH_EXACT_MAX=2000
# hnsw.ef_search for the HNSW path (recall vs. latency; pgvector default 40).
SEARCH_HNSW_EF_SEARCH=100
# Worker cron that repairs stale or missing search rows (hourly, minute 17).
SEARCH_RECONCILE_CRON="17 * * * *"
# Search documents per embeddings request in the worker indexer.
SEARCH_EMBED_BATCH=100

# --- Chat (docs/plans/step-7.md 2.4 chatEnvSchema; api) --------------------------------------
# Chat turns per user per rolling 24 h (PRD cost control: 100); then 429 rate_limited.
CHAT_TURNS_PER_DAY=100
# Model calls per turn (tool rounds) before the agent stops with a "be more specific" answer.
CHAT_MAX_TOOL_ROUNDS=4
# Output-token cap per model call.
CHAT_MAX_OUTPUT_TOKENS=800
# Earlier messages of the thread sent as context with each turn.
CHAT_HISTORY_MESSAGES=20
# Timeout per model call (ms); a turn is bounded by this x CHAT_MAX_TOOL_ROUNDS.
CHAT_MODEL_TIMEOUT_MS=30000

# --- Sharing (docs/plans/step-8.md 2.4 shareEnvSchema) -----------------------------------------
# No secret here: viewer-session JWTs and IP hashes use keys derived from JWT_SECRET.
# Lifetime (s, 30-900) of the presigned thumb/display/download URLs handed to share-link
# viewers. The api reads it from a Compose INTERPOLATION variable in docker-compose.dev.yml
# (shell or the project `.env`, like VISION_PROVIDER), so this line only documents the default:
#   SHARE_MEDIA_URL_TTL_SEC=30 docker compose -f docker-compose.dev.yml up -d --no-deps api
SHARE_MEDIA_URL_TTL_SEC=300
# Worker cron (5 fields) that re-applies auto-share rules to catch missed photo.reindex jobs.
SHARE_RECONCILE_CRON="41 * * * *"

# --- Native apps (docs/plans/step-9.md 2.3; api) ---------------------------------------------
# WebView origins allowed to call /api cross-origin (comma list; iOS capacitor://, Android
# https://localhost). CORS without credentials: the apps send bearer tokens, never cookies.
NATIVE_APP_ORIGINS=capacitor://localhost,https://localhost

# --- Push notifications (docs/plans/step-9.md 2.8; worker only) ------------------------------
# FAKE in dev. Not read from this file: set on the worker in docker-compose.dev.yml as Compose
# INTERPOLATION variables (shell or the project `.env`), so the api never has PUSH_PROVIDER:
#   PUSH_PROVIDER=fake             fake (default) | none | live
#   PUSH_PHOTOS_DEBOUNCE_SEC=600   delay before a "photos analyzed" push (s)
#   PUSH_SHARE_DEBOUNCE_SEC=60     delay before a "shared album opened" push (s; api + worker)
#   PUSH_MIN_GAP_MIN=60            at most one push per baby + kind per user per gap (min)
# Push gate: all three timings 0, see the docker-compose.dev.yml header.
# Live push from a laptop (real keys, see .env.example): APNS_* / FCM_* in .env.local (they
# reach the worker only) plus PUSH_PROVIDER=live in the shell. Never commit them here.

# --- Store-review sign-in (docs/plans/step-9.md 2.5; api only) -------------------------------
# Off in dev. Use a fresh, dedicated account, never a seeded demo-* one: review sign-in
# refuses (403) any account that belongs to a baby other than its review baby, so the demo
# accounts always fail. Runbook (packages/db/README.md, "Store-review family"):
#   1. Sign up once in the app with the new email (code in Mailpit) and accept the terms.
#   2. docker compose -f docker-compose.dev.yml run --rm migrate pnpm db:review-family --email <it>
#   3. docker compose -f docker-compose.dev.yml exec worker pnpm demo:media --review-baby <babyId>
#      (<babyId> is printed by step 2)
#   4. Put both in .env.local (the api reads them; other services get blanks), recreate the api:
#        REVIEW_ACCOUNT_EMAIL=<it>
#        REVIEW_ACCOUNT_CODE_HASH='scrypt$1$16384$8$1$<salt>$<hash>'   (single quotes: `$`)
#      Make the code and hash with: sh docker/tools/review-code-hash.sh (.env.example,
#      "Store-review sign-in").

# --- Web (Vite dev server only) ----------------------------------------------
VITE_PROXY_API_TARGET=http://api:3000
VITE_PROXY_AUTH_TARGET=http://auth:9999
# Extra hostnames Vite accepts (comma list); add your LAN hostname in .env.local for phones.
VITE_ALLOWED_HOSTS=web
# VITE_USE_POLLING=1   -> set in .env.local if hot reload misses edits on your machine
# api/worker (tsx watch) already poll: CHOKIDAR_USEPOLLING=1, CHOKIDAR_INTERVAL=500 are set in
# docker-compose.dev.yml; export CHOKIDAR_USEPOLLING=0 in your shell before `up` to turn it off.
