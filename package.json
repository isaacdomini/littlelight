{
  "name": "littlelight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up --build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project '!db-integration' --project '!api-integration' --project '!worker-integration' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --project db-integration --project api-integration --project worker-integration",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:upload-gate": "tsx e2e/upload/gate.ts",
    "e2e:ai-gate": "tsx e2e/ai/gate.ts",
    "e2e:search-gate": "tsx e2e/search/gate.ts",
    "e2e:share-gate": "tsx e2e/sharing/gate.ts",
    "e2e:export-gate": "tsx e2e/export/gate.ts",
    "e2e:push-gate": "tsx e2e/native/push-gate.ts",
    "e2e:native-android": "tsx e2e/native/android-gate.ts",
    "e2e:native-ios": "bash e2e/native/ios-gate.sh",
    "e2e:perf": "playwright test -c e2e/playwright.perf.config.ts",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @littlelight/db db:migrate",
    "db:migrate:down": "pnpm --filter @littlelight/db db:migrate:down",
    "db:seed": "pnpm --filter @littlelight/db db:seed",
    "db:bootstrap": "pnpm --filter @littlelight/db db:bootstrap",
    "db:plan": "pnpm --filter @littlelight/db db:plan",
    "db:review-family": "pnpm --filter @littlelight/db db:review-family",
    "perf:seed": "pnpm --filter @littlelight/worker perf-seed",
    "search:seed": "pnpm --filter @littlelight/worker search-seed",
    "search:bench": "pnpm --filter @littlelight/api search-bench",
    "bakeoff": "pnpm --filter @littlelight/ai bakeoff",
    "smoke": "bash e2e/smoke/dev-stack.sh",
    "search:calibrate": "pnpm --filter @littlelight/worker search-calibrate",
    "demo:media": "pnpm --filter @littlelight/worker demo-media",
    "mobile:sync": "pnpm --filter @littlelight/mobile-web native:sync",
    "mobile:android": "pnpm --filter @littlelight/mobile-web native:sync:android && pnpm --filter @littlelight/mobile-web exec cap run android --no-sync",
    "mobile:ios": "pnpm --filter @littlelight/mobile-web native:sync:ios && pnpm --filter @littlelight/mobile-web exec cap run ios --no-sync"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "exifr": "7.1.3",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
